# LiveBoom stress simulator — env example
# Copia a tools/stress-sim/.env (nunca subir secretos)

# Destino (prod por defecto; preferible staging/local)
STRESS_BASE_URL=https://liveboomapp.com

# Firebase ID token(s) de cuentas de PRUEBA (Bearer).
# Un token = 1 identidad. Varios separados por coma = multi-VU realista.
STRESS_TOKEN=
# STRESS_TOKENS=token1,token2,token3

# Sala LIVE (username del host) para /api/stream/token/:room
STRESS_ROOM=

# Fase calls (señalización audio/video): UID Firebase de un AMIGO de la cuenta del token
# STRESS_CALL_TARGET_UID=
# STRESS_CALL_TYPE=audio

# Solo fase gifts (DESTRUCTIVO: gasta coins reales)
# STRESS_ALLOW_GIFTS=1
# STRESS_GIFT_ID=boom_saludo
# STRESS_GIFT_RECIPIENT_UID=

# Solo fase presence (escribe heartbeats en Firestore con Admin SDK)
# STRESS_ALLOW_FIRESTORE=1
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

# Defaults de carga
STRESS_VUS=20
STRESS_DURATION_SEC=30
STRESS_RAMP_SEC=5
