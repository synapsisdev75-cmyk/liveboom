rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validUsername(value) {
      return value is string && value.size() >= 3 && value.size() <= 24;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'synapsisdev75@gmail.com';
    }

    function superAdminEmails() {
      return exists(/databases/$(database)/documents/config/superAdmins)
        ? get(/databases/$(database)/documents/config/superAdmins).data.get('emails', [])
        : [];
    }

    function isSuperAdmin() {
      return isOwner()
        || (signedIn() && request.auth.token.email in superAdminEmails());
    }

    match /config/levels {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /config/superAdmins {
      allow read: if isOwner()
        || (signedIn() && request.auth.token.email in resource.data.get('emails', []));
      allow create, update: if isOwner()
        && request.resource.data.ownerEmail == 'synapsisdev75@gmail.com'
        && request.resource.data.emails is list
        && 'synapsisdev75@gmail.com' in request.resource.data.emails;
      allow delete: if false;
    }

    match /adminChangeRequests/{requestId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.prompt.size() <= 8000
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 8;
      allow update: if isOwner()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewNote', 'reviewedByEmail', 'updatedAt']);
      allow delete: if isOwner();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSelf(userId)
        && request.resource.data.firebaseUid == request.auth.uid
        && validUsername(request.resource.data.username);
      allow update: if (
          isSelf(userId)
          && request.resource.data.firebaseUid == request.auth.uid
          && validUsername(request.resource.data.username)
          && request.resource.data.firebaseUid == resource.data.firebaseUid
        )
        || (
          isSuperAdmin()
          && request.resource.data.firebaseUid == resource.data.firebaseUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['levelXp', 'levelXpPinned', 'coinsBalance', 'updatedAt'])
        );
      allow delete: if isSelf(userId);

      match /friends/{friendId} {
        allow read: if true;
        allow write: if isSelf(userId) || isSelf(friendId);
      }

      match /incomingRequests/{fromUid} {
        allow read: if isSelf(userId) || isSelf(fromUid);
        allow create: if isSelf(fromUid);
        allow update, delete: if isSelf(userId) || isSelf(fromUid);
      }

      match /outgoingRequests/{toUid} {
        allow read: if isSelf(userId) || isSelf(toUid);
        allow create: if isSelf(userId);
        allow update, delete: if isSelf(userId) || isSelf(toUid);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isSelf(userId) || isSelf(followerId);
      }

      match /following/{followingId} {
        allow read: if true;
        allow write: if isSelf(userId) || isSelf(followingId);
      }

      match /blocked/{blockedId} {
        allow get: if isSelf(userId) || isSelf(blockedId);
        allow list: if isSelf(userId);
        allow write: if isSelf(userId);
      }

      match /presence/{docId} {
        allow read: if signedIn();
        allow write: if isSelf(userId);
      }

      match /liveHistory/{entryId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.username is string
          && request.resource.data.coinsEarned is number;
        allow delete: if isSelf(userId);
      }

      match /liveAlerts/{alertId} {
        allow read: if isSelf(userId);
        allow create: if signedIn();
        allow update, delete: if isSelf(userId);
      }

      match /postAlerts/{alertId} {
        allow read: if isSelf(userId);
        allow create: if signedIn();
        allow update, delete: if isSelf(userId);
      }

      match /giftInbox/{giftId} {
        allow read: if isSelf(userId);
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid == userId
          && request.resource.data.coins is number
          && request.resource.data.coins > 0
          && request.resource.data.coins <= 500000
          && request.resource.data.giftId is string
          && request.resource.data.processed == false;
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processed', 'processedAtMs']);
      }

      match /callSettings/{docId} {
        allow read: if signedIn();
        allow write: if isSelf(userId);
      }

      match /freeCallContacts/{contactId} {
        allow get: if isSelf(userId) || isSelf(contactId);
        allow list: if isSelf(userId);
        allow write: if isSelf(userId);
      }

      match /callRequests/{requestId} {
        allow read: if isSelf(userId)
          || (signedIn() && resource.data.callerId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.callerId == request.auth.uid;
        allow update: if isSelf(userId)
          || (signedIn() && resource.data.callerId == request.auth.uid);
      }

      match /callAuthorizations/{authId} {
        allow read: if isSelf(userId)
          || (signedIn() && resource.data.callerId == request.auth.uid);
        allow create, update: if isSelf(userId);
      }

      // Ubicación solo del dueño (targeting interno de ads; no se revela a otros).
      match /private/{docId} {
        allow read, write: if isSelf(userId);
      }

      match /groups/{groupId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      function chatData() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data;
      }
      function isChatParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      function isCreatingParticipant() {
        return signedIn()
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.auth.uid in request.resource.data.participants;
      }
      function otherOnCreate() {
        return request.auth.uid == request.resource.data.participants[0]
          ? request.resource.data.participants[1]
          : request.resource.data.participants[0];
      }
      function friendshipExists(a, b) {
        return exists(/databases/$(database)/documents/users/$(a)/friends/$(b));
      }
      function mutualFriends(a, b) {
        return friendshipExists(a, b) && friendshipExists(b, a);
      }
      function followingExists(a, b) {
        return exists(/databases/$(database)/documents/users/$(a)/following/$(b));
      }
      function followEitherWay(a, b) {
        return followingExists(a, b) || followingExists(b, a);
      }
      function blockedEitherWay(a, b) {
        return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
          || exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
      }
      function canMessageUser(a, b) {
        return !blockedEitherWay(a, b) && (mutualFriends(a, b) || followEitherWay(a, b));
      }
      function otherOnExisting() {
        return request.auth.uid == resource.data.participants[0]
          ? resource.data.participants[1]
          : resource.data.participants[0];
      }
      function startingNewCall() {
        return request.resource.data.call is map
          && request.resource.data.call.status == 'ringing'
          && request.resource.data.call.fromUid == request.auth.uid
          && (
            !('call' in resource.data)
            || resource.data.call == null
            || resource.data.call.id != request.resource.data.call.id
          );
      }
      function authorizedFollowerStart() {
        return request.resource.data.call is map
          && request.resource.data.call.authorizationId is string
          && exists(/databases/$(database)/documents/users/$(otherOnExisting())/callAuthorizations/$(request.resource.data.call.authorizationId))
          && get(/databases/$(database)/documents/users/$(otherOnExisting())/callAuthorizations/$(request.resource.data.call.authorizationId)).data.callerId == request.auth.uid;
      }

      allow read: if isChatParticipant() || isSuperAdmin();
      allow update: if isChatParticipant()
        && (!startingNewCall() || mutualFriends(request.auth.uid, otherOnExisting()) || authorizedFollowerStart());
      allow create: if isCreatingParticipant()
        && canMessageUser(request.auth.uid, otherOnCreate());
      allow delete: if isChatParticipant();

      match /messages/{messageId} {
        allow read: if isSuperAdmin()
          || (signedIn() && request.auth.uid in chatData().participants);
        // Si ya eres participante del chat, puedes enviar (la relación se exige al crear el chat).
        allow create: if signedIn()
          && request.auth.uid in chatData().participants
          && !blockedEitherWay(
            request.auth.uid,
            request.auth.uid == chatData().participants[0]
              ? chatData().participants[1]
              : chatData().participants[0]
          )
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        // Editar propio, soft-delete propio, o marcar entregado/leído como destinatario.
        allow update: if signedIn()
          && request.auth.uid in chatData().participants
          && (
            (
              resource.data.fromUid == request.auth.uid
              && request.resource.data.fromUid == resource.data.fromUid
            )
            || (
              resource.data.fromUid != request.auth.uid
              && request.resource.data.fromUid == resource.data.fromUid
              && request.resource.data.text == resource.data.text
            )
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
          );
        allow delete: if signedIn()
          && request.auth.uid in chatData().participants
          && resource.data.fromUid == request.auth.uid;

        match /reactions/{reactorId} {
          allow read: if signedIn() && request.auth.uid in chatData().participants;
          allow create, update: if signedIn()
            && request.auth.uid == reactorId
            && request.auth.uid in chatData().participants
            && request.resource.data.type in ['like', 'dislike'];
          allow delete: if signedIn() && request.auth.uid == reactorId;
        }
      }

      match /callBlocks/{blockId} {
        allow read: if signedIn() && request.auth.uid in chatData().participants;
        allow create: if signedIn()
          && request.auth.uid in chatData().participants
          && request.resource.data.payerUid == request.auth.uid
          && request.resource.data.rateBlasts is number
          && request.resource.data.rateBlasts > 0
          && request.resource.data.rateBlasts <= 150;
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      function postVis() {
        return request.resource.data.visibility;
      }
      function validVisibility(value) {
        return value == 'public' || value == 'friends' || value == 'private' || value == 'circle';
      }
      function isCircleViewer(authorUid) {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(authorUid))
          || exists(/databases/$(database)/documents/users/$(authorUid)/friends/$(request.auth.uid))
          || exists(/databases/$(database)/documents/users/$(authorUid)/followers/$(request.auth.uid));
      }
      function canReadPost() {
        return signedIn() && (
          resource.data.authorUid == request.auth.uid
          || resource.data.visibility == 'public'
          || resource.data.visibility == null
          || (
            resource.data.visibility == 'friends'
            && (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(resource.data.authorUid))
              || exists(/databases/$(database)/documents/users/$(resource.data.authorUid)/friends/$(request.auth.uid))
            )
          )
          || (
            resource.data.visibility == 'circle'
            && isCircleViewer(resource.data.authorUid)
          )
        );
      }

      function loadedPost() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }
      function canReadLoadedPost() {
        return signedIn() && (
          loadedPost().authorUid == request.auth.uid
          || loadedPost().visibility == 'public'
          || loadedPost().visibility == null
          || (
            loadedPost().visibility == 'friends'
            && (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(loadedPost().authorUid))
              || exists(/databases/$(database)/documents/users/$(loadedPost().authorUid)/friends/$(request.auth.uid))
            )
          )
          || (
            loadedPost().visibility == 'circle'
            && isCircleViewer(loadedPost().authorUid)
          )
        );
      }

      allow read: if canReadPost();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.username is string
        && validVisibility(postVis());
      allow update: if signedIn() && (
        (
          resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && validVisibility(postVis())
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is number
          && request.resource.data.views == resource.data.get('views', 0) + 1
        )
      );
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /views/{viewerId} {
        allow read: if signedIn() && (
          request.auth.uid == viewerId || canReadLoadedPost()
        );
        allow create, update: if signedIn()
          && request.auth.uid == viewerId
          && request.resource.data.atMs is number;
        allow delete: if false;
      }

      match /reactions/{reactorId} {
        allow read: if canReadLoadedPost();
        allow create, update: if signedIn()
          && request.auth.uid == reactorId
          && canReadLoadedPost()
          && request.resource.data.type in ['like', 'dislike'];
        allow delete: if signedIn() && request.auth.uid == reactorId;
      }

      match /comments/{commentId} {
        allow read: if canReadLoadedPost();
        allow create: if signedIn()
          && canReadLoadedPost()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 700;
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || loadedPost().authorUid == request.auth.uid
        );

        match /booms/{boomUid} {
          allow read: if canReadLoadedPost();
          allow create, update: if signedIn()
            && request.auth.uid == boomUid
            && canReadLoadedPost()
            && request.resource.data.boom == true;
          allow delete: if signedIn() && request.auth.uid == boomUid;
        }

        match /reactions/{reactorId} {
          allow read: if canReadLoadedPost();
          allow create, update: if signedIn()
            && request.auth.uid == reactorId
            && canReadLoadedPost()
            && request.resource.data.type in ['like', 'dislike'];
          allow delete: if signedIn() && request.auth.uid == reactorId;
        }
      }
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.regionId is string
        && request.resource.data.coinsPaid is number
        && request.resource.data.expiresAtMs is number;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /hashtags/{tag} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.tag is string
        && request.resource.data.count is number;
      allow delete: if false;
    }

    match /groups/{groupId} {
      function groupDoc() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }
      function memberDoc(uid) {
        return get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data;
      }
      function isGroupOwner() {
        return signedIn() && groupDoc().ownerUid == request.auth.uid;
      }
      function isGroupAdmin() {
        return signedIn()
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
          && memberDoc(request.auth.uid).role == 'admin';
      }
      function isGroupStaff() {
        return isGroupOwner() || isGroupAdmin();
      }
      function isGroupMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 48;
      // Dueño: cualquier campo. Admin: foto/nombre/desc. Cualquiera: solo memberCount.
      allow update: if signedIn() && (
        isGroupOwner()
        || (
          isGroupAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['photoUrl', 'name', 'description'])
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
      );
      allow delete: if isGroupOwner();

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == memberId;
        // Self leave/update, o staff cambia rol (nunca owner).
        allow update: if signedIn() && (
          request.auth.uid == memberId
          || (
            isGroupStaff()
            && resource.data.role != 'owner'
            && request.resource.data.role in ['admin', 'member']
            && request.resource.data.uid == resource.data.uid
          )
        );
        allow delete: if signedIn()
          && (request.auth.uid == memberId || isGroupStaff())
          && resource.data.role != 'owner';
      }

      match /messages/{messageId} {
        allow read: if isGroupMember() || isSuperAdmin();
        allow create: if isGroupMember()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            request.resource.data.text.size() > 0
            || request.resource.data.keys().hasAny(['mediaUrl', 'linkUrl'])
          )
          && (
            !('mediaUrl' in request.resource.data)
            || (
              request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
              && request.resource.data.mediaUrl.size() <= 2000
            )
          )
          && (
            !('linkUrl' in request.resource.data)
            || (
              request.resource.data.linkUrl is string
              && request.resource.data.linkUrl.size() > 0
              && request.resource.data.linkUrl.size() <= 2000
            )
          );
        allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      }

      match /joinRequests/{requestId} {
        allow read: if signedIn()
          && (request.auth.uid == requestId || isGroupStaff());
        allow create: if signedIn()
          && request.auth.uid == requestId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update, delete: if signedIn()
          && (isGroupStaff() || request.auth.uid == requestId);
      }
    }

    // Lectura pública del doc de sala: feed "Lives en línea" en tiempo real.
    match /liveRooms/{roomName} {
      allow read: if true;
      allow create, update: if signedIn();

      match /gifts/{giftId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.giftId is string
          && request.resource.data.giftName is string
          && request.resource.data.senderName is string;
        allow delete: if signedIn();
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.clientId is string
          && request.resource.data.author is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if signedIn();
      }

      match /viewers/{viewerUid} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == viewerUid
          && request.resource.data.uid == viewerUid;
        allow delete: if signedIn() && request.auth.uid == viewerUid;
      }

      match /boomEvents/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nx is number
          && request.resource.data.ny is number
          && request.auth.uid != get(/databases/$(database)/documents/liveRooms/$(roomName)).data.hostUid;
      }
    }

    match /liveBattles/{battleId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    /** Boom de comentarios: independiente de posts/{postId}/reactions. UNIQUE por commentId + userId. */
    match /commentBooms/{commentId} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      match /users/{userId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.commentId == commentId;
        allow update: if false;
        allow delete: if signedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.reporterUserId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /reportThrottle/{uid} {
      allow read, write: if false;
    }

    match /threeDReconstructions/{jobId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == jobId;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
