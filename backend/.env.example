# Copia a .env (nunca subas .env a GitHub)

# PostgreSQL (local o Cloud SQL)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/liveboom?schema=public"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
FIREBASE_PROJECT_ID="liveboom-app"

# JSON de la cuenta de servicio de Firebase (una sola línea), o base64 del mismo JSON
FIREBASE_SERVICE_ACCOUNT=

# Wompi (Dashboard → secretos de integración técnica)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Obligatorio para el Widget (Distinto del secreto de eventos):
# Dashboard Wompi → Desarrolladores → Secretos → Integridad (test_integrity_… / prod_integrity_…)
WOMPI_INTEGRITY_SECRET=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
