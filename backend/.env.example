# Copia a .env (nunca subas .env a GitHub)

# PostgreSQL (local o Cloud SQL)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/liveboom?schema=public"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
FIREBASE_PROJECT_ID="liveboom-app"

# JSON de la cuenta de servicio de Firebase (una sola línea), o base64 del mismo JSON
FIREBASE_SERVICE_ACCOUNT=

# Wompi (Dashboard → Desarrolladores → Secretos para integración técnica)
# Webhook producción: https://liveboomapp.com/api/webhooks/wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_REDIRECT_URL=https://liveboomapp.com/billetera

LIVEKIT_URL="wss://liveboom-yha3msga.livekit.cloud"
LIVEKIT_API_KEY="APIef7G7aQi7txr"
LIVEKIT_API_SECRET=

# Agora RTC — solo Batalla Boom (el LIVE normal sigue en LiveKit)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
