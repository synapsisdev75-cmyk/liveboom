rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isFriend(userId) {
      return signedIn() && (
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/friends/$(userId))
        || firestore.exists(/databases/(default)/documents/users/$(userId)/friends/$(request.auth.uid))
      );
    }
    function isFollower(userId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(userId)/followers/$(request.auth.uid));
    }
    function canReadPostFile(userId) {
      return isOwner(userId)
        || (
          signedIn()
          && resource.metadata.visibility == 'public'
        )
        || (
          resource.metadata.visibility == 'friends'
          && isFriend(userId)
        )
        || (
          resource.metadata.visibility == 'circle'
          && (isFriend(userId) || isFollower(userId))
        );
    }

    match /users/{userId}/.keep {
      allow read: if true;
      allow write: if isOwner(userId) && request.resource.size < 1024;
    }

    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/posts/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Publicaciones (foto / video / carrusel) — carpeta dedicada
    match /users/{userId}/publicaciones/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Boom Clip — videos cortos (máx. 90 s)
    match /users/{userId}/boom-clips/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Flash Boom — historias 24 h
    match /users/{userId}/flash-boom/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    match /users/{userId}/chat/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Media de grupos (portada / chat) bajo la carpeta del usuario — permisos fiables.
    match /users/{userId}/groups/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /posts/{userId}/{fileName} {
      allow read: if canReadPostFile(userId) || (signedIn() && resource.metadata.visibility == null);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    match /chat/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Ruta legacy groups/… — cualquier usuario autenticado (miembro validado en app).
    match /groups/{groupId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /admin/levels/{slug}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.token.email == 'synapsisdev75@gmail.com'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Pedidos UI — capturas. Solo el UID dueño de la carpeta puede subir.
    // Quién es super admin se valida en Firestore (adminChangeRequests) + UI.
    match /admin/change-requests/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /logo/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
