rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isFriend(userId) {
      return signedIn() && (
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/friends/$(userId))
        || firestore.exists(/databases/(default)/documents/users/$(userId)/friends/$(request.auth.uid))
      );
    }
    function isFollower(userId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(userId)/followers/$(request.auth.uid));
    }
    function canReadPostFile(userId) {
      return isOwner(userId)
        || (
          signedIn()
          && resource.metadata.visibility == 'public'
        )
        || (
          resource.metadata.visibility == 'friends'
          && isFriend(userId)
        )
        || (
          resource.metadata.visibility == 'circle'
          && (isFriend(userId) || isFollower(userId))
        );
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }
    function isBlockedChatName() {
      return request.resource.name.matches('.*\\.exe$')
        || request.resource.name.matches('.*\\.bat$')
        || request.resource.name.matches('.*\\.cmd$')
        || request.resource.name.matches('.*\\.js$')
        || request.resource.name.matches('.*\\.apk$');
    }
    function hasAllowedChatExt() {
      return request.resource.name.matches('.*\\.pdf$')
        || request.resource.name.matches('.*\\.doc$')
        || request.resource.name.matches('.*\\.docx$')
        || request.resource.name.matches('.*\\.xls$')
        || request.resource.name.matches('.*\\.xlsx$')
        || request.resource.name.matches('.*\\.ppt$')
        || request.resource.name.matches('.*\\.pptx$')
        || request.resource.name.matches('.*\\.txt$')
        || request.resource.name.matches('.*\\.zip$')
        || request.resource.name.matches('.*\\.rar$')
        || request.resource.name.matches('.*\\.jpg$')
        || request.resource.name.matches('.*\\.jpeg$')
        || request.resource.name.matches('.*\\.png$')
        || request.resource.name.matches('.*\\.gif$')
        || request.resource.name.matches('.*\\.webp$')
        || request.resource.name.matches('.*\\.heic$')
        || request.resource.name.matches('.*\\.heif$')
        || request.resource.name.matches('.*\\.mp3$')
        || request.resource.name.matches('.*\\.m4a$')
        || request.resource.name.matches('.*\\.wav$')
        || request.resource.name.matches('.*\\.ogg$')
        || request.resource.name.matches('.*\\.webm$')
        || request.resource.name.matches('.*\\.aac$')
        || request.resource.name.matches('.*\\.mp4$')
        || request.resource.name.matches('.*\\.mov$')
        || request.resource.name.matches('.*\\.mkv$');
    }
    function isAllowedChatFile() {
      return request.resource.size < 25 * 1024 * 1024
        && !isBlockedChatName()
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType == 'application/x-zip-compressed'
          || request.resource.contentType == 'application/vnd.rar'
          || request.resource.contentType == 'application/x-rar-compressed'
          || (request.resource.contentType == 'application/octet-stream' && hasAllowedChatExt())
        );
    }

    match /users/{userId}/.keep {
      allow read: if true;
      allow write: if isOwner(userId) && request.resource.size < 1024;
    }

    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/posts/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Publicaciones (foto / video / carrusel) — carpeta dedicada
    match /users/{userId}/publicaciones/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Boom Clip — videos cortos (máx. 90 s)
    match /users/{userId}/boom-clips/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Flash Boom — historias 24 h
    match /users/{userId}/flash-boom/{fileName} {
      allow read: if canReadPostFile(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    match /users/{userId}/chat/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) && isAllowedChatFile();
    }

    match /chats/{chatId}/files/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow write: if isChatParticipant(chatId) && isAllowedChatFile();
    }

    // Media de grupos (portada / chat) bajo la carpeta del usuario — permisos fiables.
    match /users/{userId}/groups/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /posts/{userId}/{fileName} {
      allow read: if canReadPostFile(userId) || (signedIn() && resource.metadata.visibility == null);
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    match /chat/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Ruta legacy groups/… — cualquier usuario autenticado (miembro validado en app).
    match /groups/{groupId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /admin/levels/{slug}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.token.email == 'synapsisdev75@gmail.com'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Pedidos UI — capturas. Solo el UID dueño de la carpeta puede subir.
    // Quién es super admin se valida en Firestore (adminChangeRequests) + UI.
    match /admin/change-requests/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /logo/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
