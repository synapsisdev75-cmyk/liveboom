# Copia a .env (raíz o packages/backend) y a apps/web/.env.local
# Nunca subas secretos a GitHub.

# PostgreSQL
DATABASE_URL="postgresql://liveboom:liveboom@127.0.0.1:55432/liveboom?schema=public"
USE_EMBEDDED_POSTGRES="true"

# API
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Firebase (web — también en apps/web/.env.local como VITE_*)
FIREBASE_PROJECT_ID="liveboom-app"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# LiveKit (opcional — sin estas keys el player usa preview de video)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Wompi (cuenta empresarial / jurídica)
WOMPI_BASE_URL="https://sandbox.wompi.co/v1"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENTS_SECRET=""
WOMPI_REDIRECT_URL="http://localhost:5173/?wallet=1"

# Vite — el frontend siempre habla con el API en Vercel
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="liveboom-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="liveboom-app"
VITE_FIREBASE_STORAGE_BUCKET="liveboom-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1092886082330"
VITE_FIREBASE_APP_ID=""
VITE_API_URL="https://liveboom.vercel.app"
VITE_LIVEKIT_URL=""