# Firebase (cliente)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=liveboom-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=liveboom-app
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API: en local el backend (npm run dev:api). En www se usa el mismo origen
# de Firebase Hosting (/api/* → Cloud Functions). No uses Vercel.
VITE_API_URL=http://localhost:4000
VITE_LIVEKIT_URL=wss://liveboom-yha3msga.livekit.cloud
